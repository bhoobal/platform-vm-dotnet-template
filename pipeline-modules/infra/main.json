{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "5818915672361853415"
    }
  },
  "parameters": {
    "workload": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12,
      "metadata": {
        "description": "Short service name, e.g. \"orders\". Lower-case letters, digits, hyphens."
      }
    },
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ]
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2s",
      "metadata": {
        "description": "VM size. B2s is fine for dev; use D-series for prod."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureadmin",
      "metadata": {
        "description": "Admin username. There is no inbound SSH rule; access is via Azure Bastion / serial console if ever needed."
      }
    },
    "adminSshPublicKey": {
      "type": "string",
      "metadata": {
        "description": "SSH public key for the admin user (password auth is disabled)."
      }
    },
    "alertEmail": {
      "type": "string",
      "metadata": {
        "description": "Team alert mailbox / DL."
      }
    },
    "logRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730
    },
    "appPort": {
      "type": "int",
      "defaultValue": 8080,
      "metadata": {
        "description": "TCP port the service listens on (localhost only, unless you add a load balancer)."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.20.0.0/24"
    },
    "subnetPrefix": {
      "type": "string",
      "defaultValue": "10.20.0.0/26"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "variables": {
    "uniq": "[take(uniqueString(resourceGroup().id), 5)]",
    "baseName": "[format('{0}-{1}', parameters('workload'), parameters('environment'))]",
    "allTags": "[union(createObject('workload', parameters('workload'), 'environment', parameters('environment'), 'managedBy', 'platform-vm-template'), parameters('tags'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "monitoring",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "baseName": {
            "value": "[variables('baseName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "retentionDays": {
            "value": "[parameters('logRetentionDays')]"
          },
          "alertEmail": {
            "value": "[parameters('alertEmail')]"
          },
          "tags": {
            "value": "[variables('allTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "3841467556416078492"
            }
          },
          "parameters": {
            "baseName": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "retentionDays": {
              "type": "int"
            },
            "alertEmail": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2025-02-01",
              "name": "[format('log-{0}', parameters('baseName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": "[parameters('retentionDays')]",
                "features": {
                  "enableLogAccessUsingOnlyResourcePermissions": true
                }
              }
            },
            {
              "type": "Microsoft.Insights/dataCollectionRules",
              "apiVersion": "2023-03-11",
              "name": "[format('dcr-{0}', parameters('baseName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "Linux",
              "properties": {
                "dataSources": {
                  "syslog": [
                    {
                      "name": "app-and-os-syslog",
                      "streams": [
                        "Microsoft-Syslog"
                      ],
                      "facilityNames": [
                        "local0",
                        "auth",
                        "authpriv",
                        "daemon"
                      ],
                      "logLevels": [
                        "Info",
                        "Notice",
                        "Warning",
                        "Error",
                        "Critical",
                        "Alert",
                        "Emergency"
                      ]
                    }
                  ],
                  "performanceCounters": [
                    {
                      "name": "basic-perf",
                      "streams": [
                        "Microsoft-Perf"
                      ],
                      "samplingFrequencyInSeconds": 60,
                      "counterSpecifiers": [
                        "Processor(*)\\% Processor Time",
                        "Memory(*)\\% Used Memory",
                        "Logical Disk(*)\\% Used Space",
                        "Network(*)\\Total Bytes"
                      ]
                    }
                  ]
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "name": "law",
                      "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Microsoft-Syslog",
                      "Microsoft-Perf"
                    ],
                    "destinations": [
                      "law"
                    ]
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
              ]
            },
            {
              "type": "Microsoft.Insights/actionGroups",
              "apiVersion": "2023-01-01",
              "name": "[format('ag-{0}', parameters('baseName'))]",
              "location": "global",
              "tags": "[parameters('tags')]",
              "properties": {
                "groupShortName": "[take(format('ag{0}', replace(parameters('baseName'), '-', '')), 12)]",
                "enabled": true,
                "emailReceivers": [
                  {
                    "name": "service-team",
                    "emailAddress": "[parameters('alertEmail')]",
                    "useCommonAlertSchema": true
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Insights/scheduledQueryRules",
              "apiVersion": "2023-12-01",
              "name": "[format('alert-{0}-heartbeat', parameters('baseName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "displayName": "[format('{0}: no AMA heartbeat', parameters('baseName'))]",
                "description": "No Heartbeat received from the VM in the last 10 minutes.",
                "severity": 1,
                "enabled": true,
                "scopes": [
                  "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT15M",
                "criteria": {
                  "allOf": [
                    {
                      "query": "Heartbeat | where Category == \"Azure Monitor Agent\" | summarize LastBeat = max(TimeGenerated) | where LastBeat < ago(10m)",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 0,
                      "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                      }
                    }
                  ]
                },
                "actions": {
                  "actionGroups": [
                    "[resourceId('Microsoft.Insights/actionGroups', format('ag-{0}', parameters('baseName')))]"
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Insights/actionGroups', format('ag-{0}', parameters('baseName')))]",
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
              ]
            },
            {
              "type": "Microsoft.Insights/scheduledQueryRules",
              "apiVersion": "2023-12-01",
              "name": "[format('alert-{0}-app-errors', parameters('baseName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "displayName": "[format('{0}: application errors', parameters('baseName'))]",
                "description": "More than 5 error-level app log lines in 5 minutes.",
                "severity": 2,
                "enabled": true,
                "scopes": [
                  "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT5M",
                "criteria": {
                  "allOf": [
                    {
                      "query": "Syslog | where Facility == \"local0\" and SeverityLevel in (\"err\",\"crit\",\"alert\",\"emerg\")",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 5,
                      "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                      }
                    }
                  ]
                },
                "actions": {
                  "actionGroups": [
                    "[resourceId('Microsoft.Insights/actionGroups', format('ag-{0}', parameters('baseName')))]"
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Insights/actionGroups', format('ag-{0}', parameters('baseName')))]",
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
              ]
            }
          ],
          "outputs": {
            "workspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('baseName')))]"
            },
            "workspaceName": {
              "type": "string",
              "value": "[format('log-{0}', parameters('baseName'))]"
            },
            "dataCollectionRuleId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Insights/dataCollectionRules', format('dcr-{0}', parameters('baseName')))]"
            }
          }
        }
      }
    },
